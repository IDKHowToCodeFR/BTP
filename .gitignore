# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environment
.env
.venv/
venv/
env/
uv.lock
pyproject.toml

# Pytest / Coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Local Config Overrides / Secrets
config.local.yaml

# -----------------------------------------------------------------------------
# BTP Project Specific
# -----------------------------------------------------------------------------

# Processed/generated data (regenerate via scripts/)
data/processed/*.csv
data/processed/*.pkl
!data/processed/.gitkeep

# Raw downloaded WS-DREAM Datasets (large, regenerate via scripts/01_download_data.py)
data/raw/wsdream1/
data/raw/wsdream2/

# Agent memory logs and caching
memory_store/*.jsonl
memory_store/*.db
memory_store/*.sqlite
*.db
*.sqlite
*.sqlite3
llm_cache.db
!memory_store/.gitkeep

# -----------------------------------------------------------------------------
# Experiment Results
# Ignore all raw results/tables by default, but explicitly track final reports
# -----------------------------------------------------------------------------
results/past_results__*
results/tables/*.csv
results/tables/*.md
!results/tables/.gitkeep
!results/tables/report_tables.md
!results/tables/extended_analysis.md
!results/tables/wsdream_complete_summary.md
!results/tables/presentation_figures.md

# -----------------------------------------------------------------------------
# Figures
# Ignore intermediate/raw figures, explicitly track presentation & report figures
# -----------------------------------------------------------------------------
results/figures/*.png
!results/figures/.gitkeep

# Core Evaluation (Report)
!results/figures/fig1_mean_regret_stable.png
!results/figures/fig2_adaptation_lag_drift.png
!results/figures/fig3_drift_recovery_timeline.png
!results/figures/fig4_performance_vs_latency.png
!results/figures/fig5_ablation_by_task.png
!results/figures/fig6_strategy_by_task.png

# WS-DREAM Validation (If generated)
!results/figures/wsdream_complete_comparison.png
!results/figures/wsdream_temporal_behavior.png
!results/figures/wsdream_profile_comparison.png

# Cache files
*.db
llm_cache*
*.dat
*.dir
*.bak

# Scratch / Debug files
scratch_*
full_experiment_log.txt

results/report/
results/tables/
